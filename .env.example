# Copy to .env.local for local work. Never commit real values (.env* is gitignored).
# Set the same names in Vercel > Project > Settings > Environment Variables.
# Use a SEPARATE TEST spreadsheet for local work and for Preview deployments.
# Only Production should point at the real lead spreadsheet.
# None of these start with NEXT_PUBLIC_, so they are never sent to the browser.

# The long id in the spreadsheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Tab (sheet) name that holds the leads. Optional, defaults to "Leads".
GOOGLE_SHEETS_TAB=Leads

# From the service account's JSON key: "client_email".
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# From the same JSON key: "private_key". Keep the quotes; newlines may stay as \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
